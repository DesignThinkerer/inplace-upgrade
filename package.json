{
  "name": "inplace-upgrade",
  "version": "0.1.6",
  "scripts": {
    "build": "TIDDLYWIKI_PLUGIN_PATH=./plugins tiddlywiki ./test/wiki --build index",
    "test": "TIDDLYWIKI_PLUGIN_PATH=./plugins tiddlywiki ./test/wiki --verbose --build test",
    "lint": "eslint plugins",
    "ci": "npm run lint && npm run test && npm run build",
    "dev": "TIDDLYWIKI_PLUGIN_PATH=./plugins npx tiddlywiki ./test/wiki --listen",
    "package": "node scripts/build.js",
    "test:e2e": "npm run test && playwright test",
    "build:plugin": "TIDDLYWIKI_PLUGIN_PATH=./plugins npx tiddlywiki ./test/wiki --rendertiddler \"$:/plugins/theophile.dev/inplace-upgrade\" \"inplace-upgrade.json\" \"text/plain\" \"$:/core/templates/tiddler.json\""
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "eslint": "^9.0.0",
    "tiddlywiki": "^5.3.2"
  }
}
