{
    "description": "Inplace-upgrade plugin development wiki",
    "plugins": [
        "tiddlywiki/jasmine",
        "tiddlywiki/tiddlyweb",
        "theophile.dev/inplace-upgrade"
    ],
    "themes": [
        "tiddlywiki/vanilla",
        "tiddlywiki/snowwhite"
    ],
    "build": {
        "index": [
            "--deletetiddlers",
            "[prefix[$:/plugins/tiddlywiki/tiddlyweb]]",
            "--setfield",
            "[[$:/DefaultTiddlers]]",
            "text",
            "[[$:/plugins/theophile.dev/inplace-upgrade]]",
            "text/vnd.tiddlywiki",
            "--output",
            "./test/wiki/output",
            "--rendertiddler",
            "$:/core/save/all",
            "index.html",
            "text/plain"
        ],
        "test": [
            "--output",
            "./test/wiki/output",
            "--rendertiddler",
            "$:/core/save/all",
            "test.html",
            "text/plain",
            "--test"
        ]
    }
}
