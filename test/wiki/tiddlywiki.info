{
    "description": "Inplace-upgrade plugin development wiki",
    "plugins": [
        "tiddlywiki/jasmine",
        "tiddlywiki/tiddlyweb",
        "theophile.dev/inplace-upgrade"
    ],
    "themes": [
        "tiddlywiki/vanilla",
        "tiddlywiki/snowwhite"
    ],
    "build": {
        "index": [
            "--deletetiddlers",
            "[prefix[$:/plugins/tiddlywiki/tiddlyweb]] [prefix[$:/plugins/tiddlywiki/jasmine]] [tag[$:/tags/test-spec]] [prefix[$:/tests/]]",
            "--setfield",
            "[[$:/DefaultTiddlers]]",
            "text",
            "$:/temp/inplace-upgrade/default-tiddlers-template",
            "text/plain",
            "--deletetiddlers",
            "[[$:/temp/inplace-upgrade/default-tiddlers-template]]",
            "--output",
            "./test/wiki/output",
            "--rendertiddler",
            "$:/core/save/all",
            "index.html",
            "text/plain"
        ],
        "test": [
            "--deletetiddlers",
            "[tag[$:/tags/demo-only]]",
            "--output",
            "./test/wiki/output",
            "--rendertiddler",
            "$:/core/save/all",
            "test.html",
            "text/plain",
            "--test"
        ]
    }
}
